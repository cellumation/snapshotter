string filename           # Name of bag file to save snapshot to. Needs to be a full path ending in .bag
string reduced_filename   # Optional: name of reduced bag file. If empty no reduced snapshot will be written.
---

bool success    # True if snapshot succesfully written to disk
string message  # Error description if failed
builtin_interfaces/Time first_timestamp   # First timestamp in the bag (excluding latched topics)
builtin_interfaces/Time last_timestamp    # Last timestamp in the bag
